{
  "name": "ghostpost",
  "version": "1.0.0",
  "private": true,
  "description": "Private, code-joined rooms with room-local ghost identities. No fake activity, no extra services.",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "tsx --test tests/unit/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 tests/database/*.test.ts",
    "test:rooms": "tsx tests/room-browser-smoke.ts",
    "test:e2e": "playwright test",
    "test:live": "tsx --env-file=.env.local scripts/live-smoke.ts",
    "check": "npm run lint && npm run typecheck && npm test && npm run test:db && npm run build",
    "db:migrate": "tsx --env-file=.env.local scripts/migrate.ts",
    "db:invite": "tsx --env-file=.env.local scripts/operator.ts invite",
    "db:admin": "tsx --env-file=.env.local scripts/operator.ts admin",
    "db:seed": "tsx --env-file=.env.local scripts/seed.ts"
  },
  "dependencies": {
    "@radix-ui/react-alert-dialog": "1.2.1",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-dropdown-menu": "2.2.1",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "clsx": "2.1.1",
    "lucide-react": "1.57.0",
    "next": "16.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "server-only": "0.0.1",
    "sonner": "2.0.8",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "24.19.2",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "embedded-postgres": "17.10.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.1",
    "pg": "8.23.1",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
