# Copy to .env.local. Keep this example blank; never commit real credentials.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Legacy projects may set NEXT_PUBLIC_SUPABASE_ANON_KEY instead.
NEXT_PUBLIC_SITE_URL=http://localhost:4318
# Google OAuth client ID/secret belong ONLY in Supabase's Google provider settings.
# No Google, Resend or SMTP secret is required in this application environment.
# Migration 202610160004 enforces 25 members per room and 6 active rooms/account.

# ONLY explicit operator/seed scripts use this; the web application never does.
# Accepts a Supabase secret key or legacy service_role key.
SUPABASE_SECRET_KEY=

# Optional migration connection string. Server/operator only, never NEXT_PUBLIC.
# Use the connection URI from Supabase > Connect (URL-encode its password).
SUPABASE_DB_URL=

# Local-only development seed (never production).
GHOSTPOST_SEED_EMAIL=
GHOSTPOST_SEED_PASSWORD=

# Historical office-only tests; current local room suite: npm run test:rooms.
# Never use production accounts or enable historical tests on the room schema.
GHOSTPOST_E2E=0
GHOSTPOST_E2E_EMAIL=
GHOSTPOST_E2E_PASSWORD=
GHOSTPOST_E2E_ADMIN_EMAIL=
GHOSTPOST_E2E_ADMIN_PASSWORD=
